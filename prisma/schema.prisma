// TeamSync data model
// Hosted on Supabase Postgres in production.

generator client {
  provider = "prisma-client-js"
}

// This Supabase project also hosts a separate "Training Sessions" app
// (organizations/app_users/teams/sessions/etc., already in the public
// schema). TeamSync's tables are applied via versioned SQL migrations
// (prisma/migrations) rather than `db push`, specifically so nothing here
// can ever diff against - and try to drop - that other app's tables.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String    @id @default(cuid())
  name      String
  sport     String
  season    String?
  createdAt DateTime  @default(now())
  // Default match-day uniform colors, set by a coach/admin in Team Settings.
  // Copied onto an Event's jerseyColor/shortsColor/socksColor when a match
  // is created with a Home or Away designation.
  homeJerseyColor String?
  homeShortsColor String?
  homeSocksColor  String?
  awayJerseyColor String?
  awayShortsColor String?
  awaySocksColor  String?
  memberships    Membership[]
  players        Player[]
  events         Event[]
  messages       Message[]
  directMessages DirectMessage[]
  trainingVideos TrainingVideo[]
  skillVideos    PlayerSkillVideo[]

}

// A user account. A single person can belong to multiple teams (e.g. a coach
// running two squads, or a parent with kids on different teams) via Membership.
//
// Credentials are no longer stored here - WordPress (the FBI Academy Coach
// Portal plugin) is the single source of truth for identity as of the full
// integration work (see INTEGRATION_ARCHITECTURE.md). wpUserId links this
// row to its WordPress wp_users.ID; passwordHash is kept only for backward
// compatibility with any rows created before the bridge existed and is no
// longer read or written by the login flow.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  wpUserId     Int?     @unique
  createdAt    DateTime @default(now())
  // Expo push token for this user's device, used to send "Notify Team"
  // event-created notifications. Overwritten on each login - simple 1
  // device/user model rather than a full multi-device token table.
  pushToken    String?

  memberships             Membership[]
  sentDirectMessages      DirectMessage[] @relation("SentMessages")
  receivedDirectMessages  DirectMessage[] @relation("ReceivedMessages")
  personalTrainingProfile PersonalTrainingProfile?

}

// A coach's public personal-training offering: who they are, their rates,
// and whether they're currently accepting bookings. One per coach User,
// created the first time that coach turns Personal Training on for
// themselves (mobile app / web portal - see routes/personalTraining.js).
// Not team-scoped: a coach's PT booking page is the same regardless of
// which team(s) they coach.
model PersonalTrainingProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  displayName    String
  photoUrl       String?
  bio            String?
  phone          String?
  // Per-session hourly rates, each set independently by the coach.
  // groupRate is nullable - a coach who doesn't want to offer small-group
  // sessions just never sets one, and the group option is hidden for them
  // on the booking page.
  individualRate Decimal  @db.Decimal(6, 2)
  groupRate      Decimal? @db.Decimal(6, 2)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  slots    PTAvailabilitySlot[]
  bookings PTBooking[]
}

// A single bookable window on a coach's calendar, created by the coach
// ahead of time. sessionType/capacity unify the individual vs. small-group
// case: an individual slot is just capacity 1. bookedCount is only ever
// changed via the atomic raw-SQL update in POST /bookings (see
// routes/personalTraining.js) so two simultaneous bookings can never both
// land on the last open seat.
model PTAvailabilitySlot {
  id          String   @id @default(cuid())
  profileId   String
  profile     PersonalTrainingProfile @relation(fields: [profileId], references: [id])
  startTime   DateTime
  endTime     DateTime
  sessionType String   @default("individual") // "individual" | "group"
  capacity    Int      @default(1)
  bookedCount Int      @default(0)
  createdAt   DateTime @default(now())

  bookings PTBooking[]

  @@index([profileId, startTime])
}

// One player/family's booking of a seat in a slot. Several bookings can
// point at the same group slot (up to its capacity); an individual slot
// (capacity 1) only ever has one. requesterUserId is set when the booking
// came from an already-logged-in TeamSync app user, left null for a public
// website visitor who isn't a TeamSync account holder.
model PTBooking {
  id              String   @id @default(cuid())
  slotId          String
  slot            PTAvailabilitySlot @relation(fields: [slotId], references: [id])
  profileId       String
  profile         PersonalTrainingProfile @relation(fields: [profileId], references: [id])
  requesterName   String
  requesterEmail  String
  requesterPhone  String?
  playerName      String?
  requesterUserId String?
  notes           String?
  status          String   @default("confirmed") // "confirmed" | "canceled"
  createdAt       DateTime @default(now())

  @@index([profileId])
  @@index([slotId])
}

// Join model: one row per (user, team) pair, carrying that user's role on
// that specific team. This is what makes multi-team support possible - a
// user's role/permissions are per-team, not global.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  role      String   // "admin" | "coach" | "player" | "parent"
  playerId  String?  @unique
  player    Player?  @relation(fields: [playerId], references: [id])
  // For role:"parent" memberships only - which child's Player this guardian
  // login can view/act on behalf of (RSVP, watch training videos, log
  // sessions, etc.) for that team. Deliberately NOT unique like playerId:
  // several guardians can share view access to the same child (both
  // parents), and one guardian gets one such row per team+child - including
  // when two of their kids are rostered on the exact same team, in which
  // case they hold two separate parent Memberships there (one per child).
  viewPlayerId String?
  createdAt DateTime @default(now())
  volunteerRoles VolunteerRole[]
  // Coach/admin RSVPs (players RSVP via Player/playerId instead - see RSVP model).
  rsvps          RSVP[]

  // NOTE: this is no longer a plain @@unique([userId, teamId]). A guardian
  // can hold multiple role:"parent" rows on the same team (one per linked
  // child), so the real constraint is two Postgres PARTIAL unique indexes,
  // applied by hand via add-membership-multi-parent-per-team.sql (this
  // project's schema is managed by hand, not `prisma migrate` - see the note
  // at the top of this file):
  //   - one membership per (userId, teamId) for role <> 'parent'
  //   - one membership per (userId, teamId, viewPlayerId) for role = 'parent'
  // Prisma's schema syntax can't express a partial index, so it's not
  // declared here - just enforced in the DB directly.
}

model Player {
  id                    String    @id @default(cuid())
  teamId                String
  team                  Team      @relation(fields: [teamId], references: [id])
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  jerseyNumber          String?
  position              String?
  birthdate             DateTime?
  photoUrl              String?
  favoritePlayerPhotoUrl String?
  guardianName          String?
  guardianPhone         String?
  guardianEmail         String?
  emergencyContact      String?
  notes                 String?
  // Player/guardian opt-in for the team-scoped training leaderboard (see
  // LeaderboardScreen). Off by default - a coach or teammate never sees a
  // player ranked unless this is explicitly turned on from their own profile.
  leaderboardOptIn      Boolean   @default(false)

  // --- WordPress sync fields ---
  wordpressPostId  Int?
  lastSyncedHash   String?
  syncStatus       String   @default("pending")
  // Links this per-team roster row to a single global player profile in
  // the FBI Academy Coach Portal (WordPress). NOT unique - one real person
  // can have a separate Player row (and this same wpPlayerId) on every
  // team they're rostered to. See INTEGRATION_ARCHITECTURE.md.
  wpPlayerId       Int?

  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  rsvps       RSVP[]
  membership  Membership?
  messages    Message[]
  videos      PlayerVideo[]
  evaluations PlayerEvaluation[]
  trainingLogs PlayerTrainingLog[]
  skillTests  PlayerSkillTest[]
  skillVideos PlayerSkillVideo[]

  @@index([wordpressPostId])
  @@index([wpPlayerId])
}

// A player/parent-submitted "skill video" (soccer tricks, juggling, etc.)
// awaiting coach/admin review. Distinct from TrainingVideo (coach-uploaded
// weekly drills, shared team library) and PlayerVideo (WordPress-sourced
// bio/highlight links) - this is the submission inbox: any roster member can
// upload one (see POST /api/uploads/skill-video, unrestricted by role,
// unlike the coach-only /api/uploads/video), but it's only visible on the
// submitter's own "My Trick Videos" list until a coach/admin approves it,
// and only shows on the public fbiacademy.org site if additionally marked
// featured. teamId is denormalized (also reachable via player.teamId) so
// the coach review-queue endpoint can query directly without a join.
model PlayerSkillVideo {
  id                      String    @id @default(cuid())
  teamId                  String
  team                    Team      @relation(fields: [teamId], references: [id])
  playerId                String
  player                  Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title                   String?
  videoUrl                String
  submittedByMembershipId String?
  status                  String    @default("pending") // "pending" | "approved" | "rejected"
  featured                Boolean   @default(false)
  coachNotes              String?
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())

  @@index([teamId])
  @@index([playerId])
  @@index([status])
}

// A video link shown on a player's profile (title + URL, e.g. YouTube/Vimeo).
// WordPress is the source of truth for these - the coach adds them on the
// player's WordPress profile, and they sync into the app via the webhook.
model PlayerVideo {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  title     String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  trainingLogs PlayerTrainingLog[]

}

// Player-logged practice time (Techne-style: captured via an in-app
// start/stop timer rather than typed in, so the numbers driving the
// streak/total-time stats on the profile are trustworthy). Optionally
// tied to a specific PlayerVideo if the player was training against a
// drill link rather than a general session. onDelete: Cascade on the
// player relation means a log never outlives its player; onDelete:
// SetNull on the video relation means a WordPress video resync (which
// deletes and recreates PlayerVideo rows) can never break an existing log
// - it just loses that back-reference.
model PlayerTrainingLog {
  id        String       @id @default(cuid())
  playerId  String
  player    Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Two separate optional back-references, deliberately not one polymorphic
  // FK: videoId points at a player's own WordPress-sourced profile video,
  // trainingVideoId points at an entry in the shared, coach-uploaded weekly
  // TrainingVideo library. A session is tied to at most one of the two.
  videoId   String?
  video     PlayerVideo? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  trainingVideoId String?
  trainingVideo   TrainingVideo? @relation(fields: [trainingVideoId], references: [id], onDelete: SetNull)
  minutes   Int
  loggedAt  DateTime     @default(now())
  note      String?
  createdAt DateTime     @default(now())

  @@index([playerId])
  @@index([videoId])
  @@index([trainingVideoId])
}

// The shared, coach-uploaded drill video library (Techne's "weekly guided
// session" equivalent) - team-scoped, NOT per-player like PlayerVideo.
// Coaches upload directly from the app (see /api/uploads/video); this is
// intentionally separate infrastructure from the WordPress-synced
// PlayerVideo model, which is a per-player bio/highlight list.
model TrainingVideo {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  title        String
  description  String?
  // Freeform tags rather than an enum, so new categories/levels don't need
  // a schema change - "Dribbling"/"Passing"/"Juggling"/"Shooting"/"Mental"/
  // "Physical"/"Recovery" and "Beginner"/"Intermediate"/"Advanced" mirror
  // Techne's own categories but aren't enforced.
  category     String?
  difficulty   String?
  videoUrl     String
  // Tags this as part of a given week's session, so the library can be
  // filtered/sorted the way Techne surfaces "this week's" content, without
  // needing a separate "session" model.
  weekOf       DateTime?
  uploadedByMembershipId String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  trainingLogs PlayerTrainingLog[]

  @@index([teamId])
}

// A player's self-recorded score for a named skill test (e.g. "Juggles in
// 60s", "Cone weave time") - distinct from PlayerEvaluation, which is a
// subjective 1-4 coach rating. This is an objective number the player (or
// a coach, on their behalf) records themselves, meant to be tracked as a
// trend across repeated attempts at the same testName.
model PlayerSkillTest {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  testName   String
  score      Float
  unit       String   // e.g. "reps", "seconds", "makes"
  recordedAt DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  @@index([playerId])
  @@index([playerId, testName])
}

// Qualitative Development Evaluation (QDE): a periodic coach assessment of
// a player across 9 attributes, each scored 1 (developing) - 4 (elite).
model PlayerEvaluation {
  id             String   @id @default(cuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id])
  evaluationDate DateTime @default(now())
  evaluator      String?
  heightWeight   String?
  preferredFoot  String?
  coachNotes     String?

  strength       Int
  speed          Int
  quickness      Int
  dribbling      Int
  longPass       Int
  mediumShot     Int
  receiving      Int
  pressAfterLoss Int
  concentration  Int

  createdAt DateTime @default(now())

}

model Event {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  type      String   // "game" | "practice" | "event" (team function)
  title     String
  location  String?
  startTime DateTime
  endTime   DateTime?
  notes     String?
  // Recurrence: when a coach creates a recurring match/training/team
  // function, one Event row is created per occurrence (simpler to query/
  // RSVP against than an RRULE), all sharing the same recurringId so they
  // can be identified as one series later if needed. repeatFreq is only
  // set on rows created via the repeat flow; a normal one-off event has
  // both fields null.
  repeatFreq   String? // "daily" | "weekly" | "monthly"
  recurringId  String?
  // Match-only fields (type === "game"). homeAway drives which of the
  // team's default uniform colors get copied onto jersey/shorts/socks
  // color at creation time - stored on the event itself (not looked up
  // live from Team) so a match's recorded uniform stays accurate even if
  // the team's default colors are changed later.
  opponent      String?
  homeAway      String? // "home" | "away"
  jerseyColor   String?
  shortsColor   String?
  socksColor    String?
  // Extra scheduling/organizational fields (mirrors common team-app features).
  locationDetails    String?  // e.g. "Field #5"
  timeTbd            Boolean  @default(false) // when true, startTime is a placeholder and the UI shows "Time TBD"
  arriveEarlyMinutes Int?     // reminder buffer, e.g. 15 = "arrive 15 min before start"
  extraLabel         String?  // short freeform subtitle shown under the title
  flagColor          String?  // hex code from a fixed preset palette (color-codes the event, distinct from match uniform colors)
  trackAvailability  Boolean  @default(true) // when false, no RSVP rows are created/tracked for this event
  notForStandings    Boolean  @default(false) // game-only: a scrimmage/friendly that doesn't count toward win/loss record
  canceled           Boolean  @default(false) // marks the event canceled without deleting it (keeps history/RSVPs)
  notifyTeam         Boolean  @default(false) // whether a push notification was sent to the team when this event was created
  createdAt DateTime @default(now())
  rsvps          RSVP[]
  volunteerRoles VolunteerRole[]

  @@index([recurringId])
}

// A volunteer slot for an event (e.g. "Snacks", "Equipment", "Photos"). A
// coach creates the slot with a title; it can optionally be assigned to a
// specific roster member (player's parent, in practice). Managed from the
// event detail screen once the event exists.
model VolunteerRole {
  id                 String      @id @default(cuid())
  eventId            String
  event              Event       @relation(fields: [eventId], references: [id])
  title              String
  assignedMembershipId String?
  assignedMembership Membership? @relation(fields: [assignedMembershipId], references: [id])
  notes              String?
  createdAt          DateTime    @default(now())

  @@index([eventId])
}

// A player's RSVP is keyed by playerId (seeded for every roster player when
// an event is created, so "Team availability" always has a full list).
// A coach/admin isn't a roster player, so their RSVP - added lazily, only
// once they actually respond - is keyed by membershipId instead. Exactly
// one of playerId/membershipId is set per row.
model RSVP {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  playerId      String?
  player        Player?     @relation(fields: [playerId], references: [id])
  membershipId  String?
  membership    Membership? @relation(fields: [membershipId], references: [id])
  status        String      @default("no_response") // "yes" | "no" | "maybe" | "no_response"
  respondedAt   DateTime?

  @@unique([eventId, playerId])
  @@unique([eventId, membershipId])
}

// Team-wide chat / announcements (broadcast to everyone on the team).
model Message {
  id             String   @id @default(cuid())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  authorPlayerId String?
  authorPlayer   Player?  @relation(fields: [authorPlayerId], references: [id])
  body           String
  isAnnouncement Boolean  @default(false)
  createdAt      DateTime @default(now())

}

// 1:1 direct message between two users who share a team.
model DirectMessage {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([teamId, senderId, recipientId])
}
