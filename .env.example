DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-this-to-a-long-random-string"

# Shared secret between this backend and the WordPress plugin.
# Must match the "TeamSync Shared Secret" field in WP Admin > Settings > TeamSync Sync.
WORDPRESS_SYNC_SECRET="change-this-too"

# Your WordPress site's REST API base, e.g. https://yourclub.com/wp-json/teamsync/v1
WORDPRESS_API_BASE="https://yourclub.com/wp-json/teamsync/v1"

# WordPress is the source of truth for login credentials (the FBI Academy
# Coach Portal plugin). WORDPRESS_FBI_API_BASE is that plugin's REST base,
# e.g. https://yourclub.com/wp-json/fbi/v1. WORDPRESS_AUTH_BRIDGE_SECRET must
# match the "Auth bridge shared secret" on WordPress's Settings > FBI
# Integration page.
WORDPRESS_FBI_API_BASE="https://yourclub.com/wp-json/fbi/v1"
WORDPRESS_AUTH_BRIDGE_SECRET="change-this-to-match-wordpress"

# Training Sessions bridge - talks to the fts/v1 REST API added to the
# fbi-training-sessions.php WordPress plugin (Settings > Training Sessions
# API on the WordPress site). FTS_API_BASE is that plugin's REST base, e.g.
# https://yourclub.com/wp-json/fts/v1
FTS_API_BASE="https://yourclub.com/wp-json/fts/v1"
TRAINING_SESSIONS_API_SECRET="change-this-to-match-wordpress"

# --- Outbound family notifications (email/SMS/WhatsApp on new/updated events) ---
# All optional - each channel is skipped independently if its vars aren't set.

# SendGrid (email). Get an API key at app.sendgrid.com > Settings > API Keys.
# SENDGRID_FROM_EMAIL must be a "Verified Sender" (or domain) in SendGrid.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="FBI Academy"

# Twilio (SMS + WhatsApp). Get these from console.twilio.com.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# A phone number you bought/rented in Twilio for SMS, e.g. +15551234567
TWILIO_SMS_FROM=""
# Twilio's WhatsApp sender, e.g. "whatsapp:+14155238886" (sandbox) or your
# own approved WhatsApp Business number once live.
TWILIO_WHATSAPP_FROM=""
# A Twilio Content Template SID (starts with "HX...") approved for
# business-initiated WhatsApp messages - required by WhatsApp policy for
# any message that isn't a reply within a live 24h chat. Create one at
# console.twilio.com > Messaging > Content Template Builder with a single
# {{1}} variable, submit for WhatsApp approval, then paste the SID here.
TWILIO_WHATSAPP_TEMPLATE_SID=""
